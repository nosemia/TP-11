#include <iostream>
using namespace std;

class Animal {
public:
    virtual void hacerRuido() {
        cout << "El animal hace un ruido" << endl;
    }

    virtual void comer() {
        cout << "El animal esta comiendo" << endl;
    }
};

class Perro : public Animal {
public:
    void hacerRuido() override {
        cout << "Guau guau" << endl;
    }

    void comer() override {
        cout << "El perro come alimento para perros" << endl;
    }
};

class Gato : public Animal {
public:
    void hacerRuido() override {
        cout << "Miau" << endl;
    }

    void comer() override {
        cout << "El gato come alimento para gatos" << endl;
    }
};

class Pajaro : public Animal {
public:
    void hacerRuido() override {
        cout << "Pio pio" << endl;
    }

    void comer() override {
        cout << "El pajaro come semillas" << endl;
    }
};

int main() {
    Perro perro;
    Gato gato;
    Pajaro pajaro;

    perro.hacerRuido();
    perro.comer();

    gato.hacerRuido();
    gato.comer();

    pajaro.hacerRuido();
    pajaro.comer();

    return 0;
}
