#include <iostream>
#include <string>
using namespace std;

class Persona {
public:
    string nombre;

    Persona(string n) {
        nombre = n;
    }
};

class Comparador {
public:
    bool comparar(int a, int b) {
        return a == b;
    }

    bool comparar(string a, string b) {
        return a == b;
    }

    bool comparar(Persona a, Persona b) {
        return a.nombre == b.nombre;
    }
};

int main() {
    Comparador c;

    cout << c.comparar(5, 5) << endl;
    cout << c.comparar("Hola", "Hola") << endl;

    Persona p1("Juan");
    Persona p2("Juan");

    cout << c.comparar(p1, p2) << endl;

    return 0;
}
