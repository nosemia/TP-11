#include <iostream>
using namespace std;

class Figura {
public:
    float calcularArea(float radio) {
        return 3.14 * radio * radio;
    }

    float calcularArea(float base, float altura) {
        return base * altura;
    }

    float calcularArea(int base, int altura) {
        return (base * altura) / 2.0;
    }
};

int main() {
    Figura f;

    cout << "Area del circulo: "
         << f.calcularArea(5.0f) << endl;

    cout << "Area del rectangulo: "
         << f.calcularArea(4.0f, 6.0f) << endl;

    cout << "Area del triangulo: "
         << f.calcularArea(4, 6) << endl;

    return 0;
}
