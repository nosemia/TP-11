#include <iostream>
using namespace std;

class Figura {
public:
    string color;

    Figura(string c) {
        color = c;
    }
};

class Circulo : public Figura {
public:
    float radio;

    Circulo(string c, float r) : Figura(c) {
        radio = r;
    }

    float calcularArea() {
        return 3.14 * radio * radio;
    }

    float calcularPerimetro() {
        return 2 * 3.14 * radio;
    }
};

class Rectangulo : public Figura {
public:
    float base, altura;

    Rectangulo(string c, float b, float a) : Figura(c) {
        base = b;
        altura = a;
    }

    float calcularArea() {
        return base * altura;
    }

    float calcularPerimetro() {
        return 2 * (base + altura);
    }
};

class Triangulo : public Figura {
public:
    float base, altura;
    float lado1, lado2, lado3;

    Triangulo(string c, float b, float a,
              float l1, float l2, float l3) : Figura(c) {
        base = b;
        altura = a;
        lado1 = l1;
        lado2 = l2;
        lado3 = l3;
    }

    float calcularArea() {
        return (base * altura) / 2;
    }

    float calcularPerimetro() {
        return lado1 + lado2 + lado3;
    }
};

int main() {
    Circulo c("Rojo", 5);
    Rectangulo r("Azul", 4, 6);
    Triangulo t("Verde", 4, 3, 3, 4, 5);

    cout << "Area del circulo: " << c.calcularArea() << endl;
    cout << "Perimetro del circulo: " << c.calcularPerimetro() << endl;

    cout << "Area del rectangulo: " << r.calcularArea() << endl;
    cout << "Perimetro del rectangulo: " << r.calcularPerimetro() << endl;

    cout << "Area del triangulo: " << t.calcularArea() << endl;
    cout << "Perimetro del triangulo: " << t.calcularPerimetro() << endl;

    return 0;
}
